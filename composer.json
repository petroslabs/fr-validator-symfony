{
    "name": "petroslabs/fr-validator-symfony",
    "description": "Symfony Validator constraints for petroslabs/fr-validator (French identifiers: NIR, RIB, SIREN/SIRET, IBAN, BIC, VAT, NAF, phone number)",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["validation", "france", "symfony", "constraint", "nir", "siret", "rib", "iban"],
    "authors": [
        {
            "name": "PetrosLabs",
            "homepage": "https://petroslabs.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/petroslabs/fr-validator-symfony/issues",
        "source": "https://github.com/petroslabs/fr-validator-symfony"
    },
    "require": {
        "php": "^8.2",
        "petroslabs/fr-validator": "^0.1",
        "symfony/validator": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.59",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "symfony/translation": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "PetrosLabs\\FrValidatorSymfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PetrosLabs\\FrValidatorSymfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "infection": "infection --min-msi=100 --min-covered-msi=100",
        "check": [
            "@test",
            "@stan",
            "@cs"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
